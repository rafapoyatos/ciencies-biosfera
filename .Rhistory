renv:::renv_retrieve_impl("yaml") |> str()
# Let's get renv to trace what it's actually downloading
# Enable download tracing
old <- options(renv.verbose = TRUE)
Sys.setenv(RENV_DOWNLOAD_TRACE = "TRUE")
# Try a direct download with renv
result <- tryCatch(
renv:::renv_download_impl(
url = "https://cloud.r-project.org/src/contrib/yaml_2.3.12.tar.gz",
destfile = tempfile(fileext = ".tar.gz"),
type = "source"
),
error = function(e) paste("Error:", e$message)
)
Sys.unsetenv("RENV_DOWNLOAD_TRACE")
options(old)
result
