library(ggplot2)
opcions <- data.frame(
nom   = c("Blau navbar\n(igual que la barra web)",
"Blau més clar",
"Gris càlid\n(color text web)",
"Marró terrós\n(accent web)",
"Verd oliva"),
color = c("#325d88", "#5b8db8", "#3e3f3a", "#a67c52", "#6b7c3e"),
text  = c("blanc", "blanc", "blanc", "blanc", "blanc")
)
ggplot(opcions, aes(x = reorder(nom, -seq_along(nom)), y = 1, fill = color)) +
geom_tile(height = 0.8, color = "white", linewidth = 1.5) +
geom_text(aes(label = paste0(nom, "\n", color)),
color = "white", fontface = "bold", size = 3.5) +
scale_fill_identity() +
coord_flip() +
theme_void() +
labs(title = "Opcions de color per als títols de diapositiva") +
theme(plot.title = element_text(hjust = 0.5, size = 13, margin = margin(b = 10)))
png("assets/img/t03-balanç-energetic/excentricitat.png",
width = 700, height = 420, res = 110, bg = "white")
# Paràmetres de l'el·lipse (excentricitat exagerada per claredat visual)
a     <- 3.0
e_vis <- 0.65
b     <- a * sqrt(1 - e_vis^2)
cf    <- a * e_vis   # distància centre-focus
rp    <- a * (1 - e_vis)
ra    <- a * (1 + e_vis)
theta <- seq(0, 2 * pi, length.out = 500)
x_ell <- a * cos(theta)
y_ell <- b * sin(theta)
par(mar = c(1, 1, 1, 1), bg = "white")
plot(x_ell, y_ell, type = "l", lwd = 2, col = "#325d88",
xlim = c(-a - 0.8, a + 0.8), ylim = c(-b - 1.0, b + 1.0),
asp = 1, axes = FALSE, xlab = "", ylab = "")
# Eix major (línia puntejada)
segments(-a, 0, a, 0, lty = 2, col = "grey60", lwd = 1.2)
# Sol (al focus)
points(cf, 0, pch = 21, bg = "#FDB813", col = "#E8A000", cex = 2.8)
text(cf, -0.55, "Sol", cex = 0.85, font = 2, col = "#E8A000")
# Focus buit (l'altre focus)
points(-cf, 0, pch = 21, bg = "white", col = "grey50", cex = 1.2)
# Centre de l'el·lipse
points(0, 0, pch = 3, cex = 1.0, col = "grey50", lwd = 1.2)
# Periheli i afeli
points( a, 0, pch = 19, cex = 1.2, col = "#325d88")
points(-a, 0, pch = 19, cex = 1.2, col = "#325d88")
text( a,  0.55, expression(italic(r)[p]), cex = 0.9, col = "#325d88", font = 2)
text(-a,  0.55, expression(italic(r)[a]), cex = 0.9, col = "#325d88", font = 2)
# Etiquetes de distàncies amb fletxes
arrows(cf, -0.25, a, -0.25, length = 0.08, code = 3,
col = "#325d88", lwd = 1.5)
text((cf + a) / 2, -0.52, expression(italic(r)[p]), cex = 0.78, col = "#325d88")
arrows(-a, -0.25, cf, -0.25, length = 0.08, code = 3,
col = "#a67c52", lwd = 1.5)
text((-a + cf) / 2, -0.52, expression(italic(r)[a]), cex = 0.78, col = "#a67c52")
# Semi-eix major
arrows(0, 0.18, a, 0.18, length = 0.08, code = 3,
col = "grey40", lwd = 1.2)
text(a / 2, 0.42, expression(italic(a)), cex = 0.82, col = "grey40")
# Fórmula excentricitat
text(0, -b - 0.60,
expression(italic(e) == frac(italic(r)[a] - italic(r)[p],
italic(r)[a] + italic(r)[p])),
cex = 1.05)
# Nota excentricitat exagerada
mtext("(excentricitat exagerada per a la il·lustració)", side = 1,
line = -0.5, cex = 0.65, col = "grey55")
dev.off()
cat("Figura desada correctament\n")
