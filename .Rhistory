# Download yaml manually and install it directly
pkg <- "yaml"
ver <- "2.3.12"
url <- sprintf("https://cloud.r-project.org/src/contrib/%s_%s.tar.gz", pkg, ver)
dest <- file.path(tempdir(), sprintf("%s_%s.tar.gz", pkg, ver))
renv_lib <- renv::paths$library()
download.file(url, destfile = dest, method = "libcurl", quiet = FALSE)
cat("File exists:", file.exists(dest), "| Size:", file.size(dest), "\n")
# Install directly into renv library, bypassing renv's interception
pkgInstall <- utils::install.packages
environment(pkgInstall) <- baseenv()
pkgInstall(dest, lib = renv_lib, repos = NULL, type = "source")
missing_pkgs <- list(
bslib = "0.10.0", cachem = "1.1.0", digest = "0.6.39",
evaluate = "1.0.5", fastmap = "1.2.0", fontawesome = "0.5.3",
htmltools = "0.5.9", jquerylib = "0.1.4", jsonlite = "2.0.0",
knitr = "1.51", lifecycle = "1.0.5", memoise = "2.0.1",
mime = "0.13", rappdirs = "0.3.4", rmarkdown = "2.30",
sass = "0.4.10", yaml = "2.3.12"
)
renv_lib <- renv::paths$library()
tmpdir <- tempdir()
base_url <- "https://cloud.r-project.org/src/contrib"
for (pkg in names(missing_pkgs)) {
ver <- missing_pkgs[[pkg]]
fname <- sprintf("%s_%s.tar.gz", pkg, ver)
url <- file.path(base_url, fname)
dest <- file.path(tmpdir, fname)
cat("Downloading", pkg, ver, "...\n")
tryCatch({
download.file(url, destfile = dest, method = "libcurl", quiet = TRUE)
utils::install.packages(dest, lib = renv_lib, repos = NULL, type = "source",
INSTALL_opts = "--no-test-load")
cat("  OK\n")
}, error = function(e) cat("  FAILED:", e$message, "\n"))
}
warnings()
renv_lib <- renv::paths$library()
# What's actually installed and usable in the renv library?
installed <- installed.packages(lib.loc = renv_lib)[, c("Package", "Version")]
installed
# Full list of what's needed, in install order (dependencies first)
# Note: rmarkdown 2.30 is 404 on CRAN - we'll use 2.31 (latest)
needed <- list(
# No R-pkg deps
"R6"          = list(ver = "2.6.1",  url = "https://cloud.r-project.org/src/contrib/R6_2.6.1.tar.gz"),
"base64enc"   = list(ver = "0.1-3",  url = "https://cloud.r-project.org/src/contrib/base64enc_0.1-3.tar.gz"),
"cli"         = list(ver = "3.6.5",  url = "https://cloud.r-project.org/src/contrib/cli_3.6.5.tar.gz"),
"highr"       = list(ver = "0.11",   url = "https://cloud.r-project.org/src/contrib/highr_0.11.tar.gz"),
"xfun"        = list(ver = "0.56",   url = "https://cloud.r-project.org/src/contrib/xfun_0.56.tar.gz"),
"fs"          = list(ver = "1.6.6",  url = "https://cloud.r-project.org/src/contrib/fs_1.6.6.tar.gz"),
# Needs cli
"rlang"       = list(ver = "1.1.7",  url = "https://cloud.r-project.org/src/contrib/rlang_1.1.7.tar.gz"),
# Needs rlang, fastmap
"cachem"      = list(ver = "1.1.0",  url = "https://cloud.r-project.org/src/contrib/cachem_1.1.0.tar.gz"),
# Needs base64enc, rlang
"htmltools"   = list(ver = "0.5.9",  url = "https://cloud.r-project.org/src/contrib/htmltools_0.5.9.tar.gz"),
# Needs cli, rlang
"lifecycle"   = list(ver = "1.0.5",  url = "https://cloud.r-project.org/src/contrib/lifecycle_1.0.5.tar.gz"),
# Needs rlang, cachem
"memoise"     = list(ver = "2.0.1",  url = "https://cloud.r-project.org/src/contrib/memoise_2.0.1.tar.gz"),
# Needs htmltools
"jquerylib"   = list(ver = "0.1.4",  url = "https://cloud.r-project.org/src/contrib/jquerylib_0.1.4.tar.gz"),
# Needs rlang, htmltools
"fontawesome" = list(ver = "0.5.3",  url = "https://cloud.r-project.org/src/contrib/fontawesome_0.5.3.tar.gz"),
# Needs fs, rlang, htmltools, R6
"sass"        = list(ver = "0.4.10", url = "https://cloud.r-project.org/src/contrib/sass_0.4.10.tar.gz"),
# Needs highr, xfun, yaml (yaml already installed)
"knitr"       = list(ver = "1.51",   url = "https://cloud.r-project.org/src/contrib/knitr_1.51.tar.gz"),
# Needs tinytex
"tinytex"     = list(ver = "0.58",   url = "https://cloud.r-project.org/src/contrib/tinytex_0.58.tar.gz"),
# Needs bslib, evaluate, fontawesome, htmltools, jquerylib, jsonlite, knitr,
#       lifecycle, rmarkdown, sass, xfun
"bslib"       = list(ver = "0.10.0", url = "https://cloud.r-project.org/src/contrib/bslib_0.10.0.tar.gz"),
# Use 2.31 (2.30 is 404)
"rmarkdown"   = list(ver = "2.31",   url = "https://cloud.r-project.org/src/contrib/rmarkdown_2.31.tar.gz")
)
cat("Script ready. Packages to install:", paste(names(needed), collapse = ", "), "\n")
