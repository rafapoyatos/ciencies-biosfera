# Check renv library paths and whether packages are actually installed
.libPaths()
cat("\n--- renv project library:\n")
renv::paths$library()
cat("\n--- Packages in renv library:\n")
installed.packages(lib.loc = renv::paths$library()) |> rownames()
# Try to install with a different CRAN mirror
options(repos = c(CRAN = "https://cloud.r-project.org"))
renv::restore(prompt = FALSE)
# Check if CRAN is accessible at all
tryCatch(
available.packages(repos = "https://cloud.r-project.org")[1:3, "Version"],
error = function(e) paste("Error:", e$message)
)
R.version.string
# Try installing a failing package directly to understand the error
renv::install("yaml@2.3.12", prompt = FALSE)
# Check what version is available on CRAN vs what's locked
pkgs_check <- c("yaml", "bslib", "knitr", "rmarkdown", "jsonlite", "digest")
ap <- available.packages(repos = "https://cloud.r-project.org")
ap[pkgs_check, c("Version", "Repository")]
# Check what URL renv is actually trying
options(renv.verbose = TRUE)
tryCatch(
renv::install("yaml@2.3.12", prompt = FALSE),
error = function(e) message(e$message)
)
# Force source installation and try again
options(
renv.verbose = TRUE,
pkgType = "source",
install.packages.compile.from.source = "always"
)
renv::install("yaml@2.3.12", prompt = FALSE, type = "source")
# Check renv's download method and repos
renv::config$repos.override()
getOption("repos")
renv:::renv_download_method()
# Try manual download to diagnose
url <- "https://cloud.r-project.org/src/contrib/yaml_2.3.12.tar.gz"
destfile <- tempfile(fileext = ".tar.gz")
result <- tryCatch(
download.file(url, destfile, method = "curl", quiet = FALSE),
error = function(e) paste("Download error:", e$message)
)
cat("Download result:", result, "\n")
cat("File size:", file.size(destfile), "\n")
renv::restore()
# Test if basic downloading works at all
test_url <- "https://cloud.r-project.org/src/contrib/yaml_2.3.12.tar.gz"
dest <- tempfile(fileext = ".tar.gz")
download.file(test_url, dest, method = "libcurl")
cat("File size:", file.size(dest), "bytes\n")
options(download.file.method = "libcurl")
renv::restore(prompt = FALSE)
# Check what renv decides to download for a failing vs working package
