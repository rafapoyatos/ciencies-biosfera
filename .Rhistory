renv:::renv_package_download_url("yaml", "2.3.12", "CRAN", type = "source")
# Check renv internals for download
renv:::renv_retrieve_package_need_download("yaml")
# Look at renv's download infrastructure
ls(envir = asNamespace("renv")) |> grep("download", x = _, value = TRUE, ignore.case = TRUE)
# Check the parallel download method being used and trace a download
renv:::renv_download_parallel_method()
# Also check curl config
renv:::renv_download_curl_config()
# Check what renv tries to retrieve for yaml - trace the lookup
options(renv.verbose = TRUE)
renv:::renv_retrieve_repos("yaml")
